# Copy to deploy/.env.production (gitignored) on the server and fill in the values.
# Used both by docker compose (interpolation) and as the backend container's environment.

# ── Public address ───────────────────────────────────────────────────────────
# Your Cloudflare hostname, no trailing slash. Used for CORS and invite-email links.
APP_FRONTEND_URL=https://saarthi.example.com
CORS_ORIGINS=https://saarthi.example.com
CLOUDFLARE_TUNNEL_TOKEN=

# ── Security (must change) ───────────────────────────────────────────────────
# Generate:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ADMIN_SECRET_TOKEN=
# Shared by Caddy and the backend: only requests carrying it may set the client IP.
PROXY_SECRET=
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
# Keep these OFF in production:
SAARTHI_ENABLE_DEMO_USERS=0
SAARTHI_DEV_AUTOCREATE_TABLES=0

# ── Database (Neon, pooled connection) ───────────────────────────────────────
# postgresql+asyncpg://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?ssl=require
DATABASE_URL=

# ── LLM: Gemini through its OpenAI-compatible endpoint ───────────────────────
OPENAI_API_KEY=
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
CHAT_MODEL=gemini-2.5-flash
ROUTER_MODEL=gemini-2.5-flash-lite
EMBEDDING_MODEL=gemini-embedding-001
GEMINI_API_KEY=
KB_CHAT_MODEL=gemini-3.5-flash-lite
KB_EMBED_MODEL=gemini-embedding-001

# ── Local GPU model (profile "gpu"): see docs/DEPLOYMENT.md §6 ───────────────
# LOCAL_BASE_URL=http://ollama:11434/v1
# LOCAL_API_KEY=ollama
# LOCAL_CHAT_MODEL=qwen2.5:14b

# ── Knowledge base (Qdrant Cloud) ────────────────────────────────────────────
QDRANT_BACKEND=cloud
QDRANT_CLOUD_URL=
QDRANT_CLOUD_API_KEY=
QDRANT_COLLECTION=saarthi_knowledge_base_v1

# ── Optional integrations ────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_KEY=
YOUTUBE_API_KEY=
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@saarthi.example.com

# ── Limits / behaviour ───────────────────────────────────────────────────────
FAST_CHAT=0
STUDENT_DAILY_TOKENS=20000
INSTRUCTOR_DAILY_TOKENS=50000

# BGE-M3 + Qdrant knowledge-base pipeline — copy to .env.kb (or export
# these directly in your shell) and fill in real values. Never commit
# the real .env.kb file.
#
# This is separate from saarthi_backend/.env(.example) — that file
# configures the existing backend app; this one configures only the new
# KB pipeline (scripts/normalize_content_kb.py, chunk_content_kb.py,
# embed_chunks_kb.py, build_kb_qdrant.py, validate_kb_qdrant.py,
# export_kb_qdrant.py).

# REQUIRED: root directory for all generated KB data (raw copies,
# normalized docs, chunks, embeddings, manifests, reports, model cache,
# Qdrant storage). Must be outside this Git repository. Machine-specific —
# set your own value in .env.kb; the placeholder below is an EXAMPLE only.
# Windows example: E:\SaarthiData   Linux/macOS example: /srv/saarthi-data
SAARTHI_KB_DATA_ROOT=CHANGE_ME_absolute_path_outside_this_repo

# Qdrant connection. No API key needed for local development — leave
# QDRANT_API_KEY unset/blank for a local, unauthenticated instance.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=saarthi_knowledge_base_v1

# Optional overrides (uncomment to set; defaults come from
# configs/kb_pipeline.yaml otherwise):
# SAARTHI_KB_EMBED_DEVICE=auto
# SAARTHI_KB_EMBED_BATCH_SIZE=16

# --- PaddleOCR math/handwriting OCR feature flags (Part 3) ---
# All three are read by scripts/ingest_notes.py / ingest_videos.py too,
# loaded via scripts/env_loader.py — this file (copied to .env.kb) makes
# them persistent instead of re-setting them every terminal session.
# A real environment variable already set in your shell always wins over
# these — set one temporarily with e.g. PowerShell's
# `$env:SAARTHI_HANDWRITING_OCR = "trocr"` to override just that run.
# Requires the dedicated .venv-ocr environment — see
# docs/KB_PIPELINE_SETUP.md §13b. Comment out to fall back to Tesseract-only.
SAARTHI_HANDWRITING_OCR=paddleocr
SAARTHI_REGION_ANALYSIS=1
SAARTHI_MATH_ANALYSIS=1
